{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/collaborate",
      "destination": "/index.html"
    },
    {
      "source": "/coa/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/hemp/:slug",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/hemp",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/hemp/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/coa/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
