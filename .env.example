# Google Maps Locator Plus — the "Find us" map in the Visit section. Browser key,
# shipped to the client on purpose (VITE_ prefix): restrict it by HTTP referrer
# (vibesupplyco.org/*, www.vibesupplyco.org/*, *.vercel.app/*, localhost) and to the
# Maps JavaScript, Places, Directions and Distance Matrix APIs. Unset → address +
# directions link instead of a map.
VITE_GOOGLE_MAPS_API_KEY=
# Optional cloud Map ID for custom map styling; defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
